# Names only — real values go in .env.local, which is gitignored.

# Required
OPENAI_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Optional — exercise 04 and the TUI use Tavily if this is set,
# and fall back to OpenAI's hosted web search if it isn't.
TAVILY_API_KEY=

# Optional — exercise 05 swaps providers. Without it you see the one-line diff.
ANTHROPIC_API_KEY=
